# Optional, installation-specific LAN TLS. Never adds a trusted root.
function Get-AGMobileTlsIdentity {
    param([Parameter(Mandatory)][string]$Directory,[Parameter(Mandatory)][string]$IPAddress,[bool]$AllowAuthorityCreation=$true)
    $ip=$null
    if(-not [Net.IPAddress]::TryParse($IPAddress,[ref]$ip) -or $ip.AddressFamily -ne [Net.Sockets.AddressFamily]::InterNetwork){throw 'Invalid LAN IPv4 address.'}
    New-Item -ItemType Directory -Path $Directory -Force | Out-Null
    $metadataPath=Join-Path $Directory 'identity.json'
    $metadata=if(Test-Path -LiteralPath $metadataPath){Get-Content -LiteralPath $metadataPath -Raw | ConvertFrom-Json}else{$null}
    $authority=$null;$certificate=$null
    if($metadata){
        # Read the Windows store explicitly: do not depend on provider state
        # inherited by a long-running background PowerShell process.
        $store=[Security.Cryptography.X509Certificates.X509Store]::new('My',[Security.Cryptography.X509Certificates.StoreLocation]::CurrentUser)
        try{
            $store.Open([Security.Cryptography.X509Certificates.OpenFlags]::ReadOnly)
            if([string]$metadata.authority -match '^[0-9A-F]{40}$'){$authority=@($store.Certificates.Find([Security.Cryptography.X509Certificates.X509FindType]::FindByThumbprint,[string]$metadata.authority,$false))[0]}
            if([string]$metadata.server -match '^[0-9A-F]{40}$'){$certificate=@($store.Certificates.Find([Security.Cryptography.X509Certificates.X509FindType]::FindByThumbprint,[string]$metadata.server,$false))[0]}
        }finally{$store.Close()}
    }
    # CA stays in Personal, NOT Root. Keys cannot be exported by this workflow.
    if(-not $authority -or -not $authority.HasPrivateKey -or $authority.NotAfter -lt (Get-Date).AddDays(30)){
        if(-not $AllowAuthorityCreation){throw ('Local certificate authority is unavailable or needs renewal. Certificate present: {0}; private key available: {1}; metadata: {2}. Return to HTTP in secure connection setup before preparing a replacement.' -f [bool]$authority,[bool]($authority -and $authority.HasPrivateKey),$metadataPath)}
        $authority=New-SelfSignedCertificate -Type Custom -Subject ('CN=AlienGamer Mode Local CA '+[guid]::NewGuid().ToString('N').Substring(0,8)) -CertStoreLocation 'Cert:\CurrentUser\My' -KeyAlgorithm RSA -KeyLength 2048 -HashAlgorithm SHA256 -KeyExportPolicy NonExportable -KeyUsage CertSign,CRLSign -TextExtension @('2.5.29.19={critical}{text}ca=1&pathlength=0') -NotAfter (Get-Date).AddYears(3)
        $certificate=$null
    }
    if(-not $certificate -or -not $certificate.HasPrivateKey -or $certificate.Issuer -ne $authority.Subject -or $metadata.ip -ne $IPAddress -or $certificate.NotAfter -lt (Get-Date).AddDays(7)){
        $expires=(Get-Date).AddDays(90)
        if($expires-gt$authority.NotAfter.AddDays(-1)){$expires=$authority.NotAfter.AddDays(-1)}
        $certificate=New-SelfSignedCertificate -Type Custom -Subject 'CN=AlienGamer Mode LAN' -Signer $authority -CertStoreLocation 'Cert:\CurrentUser\My' -KeyAlgorithm RSA -KeyLength 2048 -HashAlgorithm SHA256 -KeyExportPolicy NonExportable -KeyUsage DigitalSignature,KeyEncipherment -TextExtension @("2.5.29.17={text}IPAddress=$IPAddress",'2.5.29.19={critical}{text}ca=0','2.5.29.37={text}1.3.6.1.5.5.7.3.1') -NotAfter $expires
    }
    $publicBytes=$authority.Export([Security.Cryptography.X509Certificates.X509ContentType]::Cert)
    $hash=[Security.Cryptography.SHA256]::Create()
    try{$fingerprint=([BitConverter]::ToString($hash.ComputeHash($publicBytes))).Replace('-',':')}finally{$hash.Dispose()}
    $publicPath=Join-Path $Directory 'AlienGamerMode-Local-CA.cer'
    [IO.File]::WriteAllBytes($publicPath,$publicBytes)
    $record=[ordered]@{authority=$authority.Thumbprint;server=$certificate.Thumbprint;ip=$IPAddress;fingerprint=$fingerprint;name=$authority.Subject;expires=$certificate.NotAfter.ToString('o')}
    $temporary=$metadataPath+'.tmp'
    [IO.File]::WriteAllText($temporary,($record|ConvertTo-Json),(New-Object Text.UTF8Encoding($false)))
    Move-Item -LiteralPath $temporary -Destination $metadataPath -Force
    [pscustomobject]@{Certificate=$certificate;PublicPath=$publicPath;Fingerprint=$fingerprint;Name=$authority.Subject;Expires=$certificate.NotAfter.ToString('o')}
}

function Get-AGMobileSetupHtml {
    param([string]$Fingerprint,[string]$Name,[string]$SecureUrl)
    $fingerprintText=[Net.WebUtility]::HtmlEncode($Fingerprint)
    $nameText=[Net.WebUtility]::HtmlEncode($Name)
    $secureLink=[Net.WebUtility]::HtmlEncode($SecureUrl)
    @"
<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>AlienGamer Mode · HTTPS</title>
<style>:root{color-scheme:dark}body{margin:0;background:#181818;color:#eee;font:16px/1.5 system-ui}main{max-width:680px;margin:auto;padding:24px}section,details{background:#202020;border:1px solid #4c4c4c;border-radius:16px;padding:20px;margin:16px 0}a{color:#ff9940}a.action{display:inline-block;padding:12px 20px;background:#ff9940;color:#181818;border-radius:12px;font-weight:600}code{display:block;overflow-wrap:anywhere;font-size:14px}summary{cursor:pointer;font-weight:600;min-height:44px}a:focus-visible,summary:focus-visible{outline:3px solid #ff9940;outline-offset:4px}</style>
<main><h1>Conexión segura / Secure connection</h1><p>El teléfono y la laptop deben estar en la misma red. / Keep both devices on the same local network.</p>
<section><h2>1 · Verifica antes de instalar / Verify first</h2><p>Compara esta huella SHA-256 con la laptop, no sólo el nombre. Si difiere, no instales el archivo. / Compare this SHA-256 fingerprint with your laptop. If it differs, do not install.</p><p>$nameText</p><code>$fingerprintText</code><p>Instalar una autoridad raíz es un permiso sensible: puede permitir confiar en otros certificados firmados por ella. / A root authority is sensitive: trust can extend to other certificates it signs.</p><a class="action" href="../certificate">Descargar certificado público / Download public certificate</a></section>
<section><h2>2 · Instala en el celular / Install on your phone</h2><details open><summary>Samsung · ruta comprobada en S26 Ultra / Verified S26 Ultra path</summary><ol><li>Descarga el certificado público con el botón del paso 1. / Download the public certificate in step 1.</li><li>Abre Ajustes → Seguridad y privacidad → Más ajustes de seguridad → Instalar desde almacenamiento del dispositivo. / Settings → Security and privacy → More security settings → Install from device storage.</li><li>Selecciona <strong>Certificado de CA</strong>, no Wi-Fi ni VPN. Empieza desde Ajustes, no abriendo el archivo directamente. / Choose <strong>CA certificate</strong>, not Wi-Fi or VPN. Start in Settings, not by opening the file.</li><li>Tras comparar la huella con la laptop, acepta el permiso de instalación e introduce tu PIN si se solicita. Selecciona AlienGamerMode-Local-CA.cer en Descargas. / After comparing the fingerprint with your laptop, accept installation and enter your PIN if requested. Select AlienGamerMode-Local-CA.cer in Downloads.</li><li>En Más ajustes de seguridad → Ver certificados de seguridad → Usuario, comprueba que aparezca el nombre indicado en el paso 1. / In More security settings → View security certificates → User, check for the name shown in step 1.</li></ol><p>El aviso al <strong>instalar una CA</strong> solicita un permiso sensible. No es lo mismo que ignorar una advertencia de conexión del navegador. Si no existe la opción CA, no elijas Wi-Fi ni desactives protecciones. Los nombres pueden variar según versión y región. / The <strong>CA installation</strong> warning requests sensitive trust. It is different from bypassing a browser connection warning. If CA is unavailable, do not choose Wi-Fi or disable protections. Labels may vary by version and region.</p></details><details><summary>Otros Android / Other Android devices</summary><p>Busca en Ajustes «Instalar certificado», a veces dentro de Cifrado y credenciales. Selecciona Certificado de CA y verifica la huella antes de confirmar. Si el dispositivo impide instalarlo, conserva HTTP. / In Settings, search for “Install certificate”, sometimes under Encryption and credentials. Choose CA certificate and verify the fingerprint before confirming. If blocked, keep HTTP.</p></details><details><summary>iPhone / iPad</summary><p>Abre el archivo con Safari y revisa el perfil descargado en Ajustes → General → VPN y gestión de dispositivos. Después, en General → Información → Ajustes de confianza de certificados, activa la confianza sólo para esta autoridad.</p><p>Open in Safari, review the downloaded profile in Settings → General → VPN &amp; Device Management, then enable this authority in General → About → Certificate Trust Settings.</p></details></section>
<section><h2>3 · Vuelve a la laptop / Return to your laptop</h2><p>Pulsa «Activar HTTPS» en el asistente de la laptop y luego abre el monitor. No ignores advertencias de certificado. / Select “Activate HTTPS” on the laptop, then open the monitor. Never bypass certificate warnings.</p><a class="action" href="$secureLink">Abrir monitor HTTPS / Open HTTPS monitor</a><p>La opción de mantener pantalla encendida requiere un navegador compatible y permiso concedido; HTTPS no garantiza disponibilidad. / Keeping the screen awake also requires browser support and permission.</p></section>
<section><h2>4 · Comprueba el resultado / Check the result</h2><ol><li>Cierra Chrome completamente y vuelve a abrirlo. Escanea el QR HTTPS actualizado de la laptop. No necesitas generar un certificado nuevo. / Fully close and reopen Chrome. Scan the current HTTPS QR on your laptop. You do not need a new certificate.</li><li>Pulsa el icono junto a la dirección → información de conexión. Debe decir <strong>La conexión es segura</strong> y reconocer la autoridad de esta laptop. / Tap the icon beside the address → connection information. It should say <strong>Connection is secure</strong> and recognize this laptop's authority.</li><li>En el monitor, pulsa Editar → Mantener pantalla encendida. Mantén la página visible. / In the dashboard, tap Edit → Keep screen awake. Keep the page visible.</li></ol><details><summary>Así debe verse / Expected secure result</summary><p>Ejemplo real de Chrome: conexión segura. La IP y el nombre de autoridad serán diferentes en otros equipos. / Real Chrome example: secure connection. Other installations have different IP addresses and authority names.</p><img src="../examples/https-secure.jpg" alt="Chrome: La conexión es segura / Connection is secure" loading="lazy" style="display:block;width:100%;max-width:360px;height:auto;margin:auto"></details><details><summary>Si ves esto, revisa la instalación / If you see this, check setup</summary><p>NET::ERR_CERT_AUTHORITY_INVALID: no se ha verificado la autoridad. No uses Continuar (no seguro) como solución. Sigue la ayuda de abajo. / The authority has not been verified. Do not use Proceed (unsafe) as the fix. Follow troubleshooting below.</p><img src="../examples/https-untrusted.jpg" alt="Chrome: NET::ERR_CERT_AUTHORITY_INVALID, conexión no privada / connection not private" loading="lazy" style="display:block;width:100%;max-width:360px;height:auto;margin:auto"></details></section>
<details><summary>Advertencia roja o conexión no privada / Red warning or connection not private</summary><p>Si ves HTTPS tachado o «Tu conexión no es privada», la configuración necesita revisión. Estar en una red local no garantiza la identidad de la laptop. «Avanzado → Continuar (no seguro)» omite la verificación del certificado; no es un paso obligatorio. Que el monitor abra o mantenga la pantalla encendida no confirma que la confianza esté bien instalada.</p><p>Comprueba que instalaste el archivo como <strong>certificado de CA</strong>, no como certificado Wi-Fi/VPN, y compara su huella con la laptop. En iPhone/iPad comprueba también la confianza completa. Cierra y vuelve a abrir el navegador, usa el QR actualizado y revisa fecha/hora. Si persiste, anota el código exacto del error y vuelve a HTTP desde la laptop mientras se revisa.</p><p>If HTTPS is crossed out or you see “Your connection is not private”, setup needs checking. A local network does not by itself authenticate your laptop. “Advanced → Proceed (unsafe)” bypasses certificate verification; it is not a required step. A working dashboard or screen-awake feature does not prove correct certificate trust.</p><p>Install as a <strong>CA certificate</strong>, not a Wi-Fi/VPN certificate, and compare its fingerprint with the laptop. On iPhone/iPad also check full trust. Restart the browser, use the latest QR and check device date/time. If the warning remains, record its exact error code and return to HTTP on the laptop while investigating.</p></details>
<details><summary>Retirar confianza / Remove trust</summary><p>Elimina esta CA en los certificados de usuario de Android o el perfil instalado de iOS. Apagar HTTPS en la laptop no elimina el certificado del teléfono.</p><p>Remove this CA from Android user credentials or remove its iOS profile. Switching HTTPS off does not remove phone trust.</p></details></main></html>
"@
}
Export-ModuleMember -Function Get-AGMobileTlsIdentity,Get-AGMobileSetupHtml
