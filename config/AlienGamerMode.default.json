  "installation": {
    "desktopShortcut": true,
    "startMenuShortcut": true,
    "startWithWindows": false,
    "launchAfterInstall": true
  },
  "behavior": {
    "disableDefaultRainmeterSkins": true,
    "startHWiNFOHidden": true,
    "closeOnlyOwnedProcesses": true,
    "startupTimeoutSeconds": 35
  }
